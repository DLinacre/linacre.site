# All integrations are optional. Unconfigured features return an unavailable state.
# AI providers (server-side secrets; do not use VITE_ prefixes)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Shared AI/auth rate limiting; in-memory fallback is per instance only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_PER_MIN=20

# Dashboard: long random session secret (32+ characters) and SHA-256 hex hash
# of a strong unique password. Authentication is disabled when unset.
DASHBOARD_SESSION_SECRET=
DASHBOARD_PASSWORD_HASH=

# Contact delivery: sender must be from a verified Resend domain.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
