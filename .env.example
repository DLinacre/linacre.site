# All variables are OPTIONAL. The site builds and runs without any of them;
# an absent key disables its feature rather than breaking the build.

# AI assistant (Google Gemini)
GEMINI_API_KEY=

# API rate limiting (Upstash Redis) — falls back to in-memory when unset
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Contact form delivery (Resend)
RESEND_API_KEY=
